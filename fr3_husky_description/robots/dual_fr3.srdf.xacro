    <!-- ============= right arm ============= -->
    <!-- right arm - right arm -->
    <xacro:franka_arm_srdf arm_id="fr3"
                           hand="$(arg hand)"
                           ee_id="franka_hand"
                           no_prefix="false"
                           arm_prefix="right_">
    </xacro:franka_arm_srdf>

    <xacro:if value="$(arg with_sc)">
        <disable_collisions link1="right_fr3_link0" link2="right_fr3_link5" reason="User"/>
        <disable_collisions link1="right_fr3_link0" link2="right_fr3_link6" reason="User"/>
        <disable_collisions link1="right_fr3_link0" link2="right_fr3_link7" reason="User"/>
        <disable_collisions link1="right_fr3_link1" link2="right_fr3_link5" reason="User"/>
