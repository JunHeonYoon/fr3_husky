    <!-- right arm - right arm sc -->
    <xacro:if value="$(arg with_sc)">
        <disable_collisions link1="right_fr3_link0" link2="right_fr3_link0_sc" reason="Adjacent"/>
        <disable_collisions link1="right_fr3_link0" link2="right_fr3_link1_sc" reason="Default"/>
