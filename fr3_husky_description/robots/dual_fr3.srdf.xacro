<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3">

    <xacro:include filename="$(find franka_description)/robots/common/franka_arm.srdf.xacro"/>
    <xacro:include filename="$(find fr3_husky_description)/robots/husky_base.srdf.xacro"/>

    <!-- ============================================================= -->

    <!-- Should an end-effector be mounted at the flange? -->
    <xacro:arg name="hand" default="true" />

    <!-- Is base husky or just box-shaped? -->
    <xacro:arg name="mobile" default="true"/>

    <!-- Should self-collision be enabled? -->
    <xacro:arg name="with_sc" default="true" />

    <!-- Add Azure Kinect to the Husky Base? -->
    <xacro:arg name="use_azure" default="true" />

    <!-- Add Intel RealSense D435i to both EE of FR3? ? -->
    <xacro:arg name="use_d435i" default="true" />
    <!-- ============================================================= -->

    <!-- link list: left hand, left hand sc, left d435i, left arm, left arm sc, right hand, right hand sc, right arm, right arm sc, right d435i, base  -->

    <!-- ============= left hand ============= -->
    <!-- left hand - left hand -->
    <!-- already in franka_arm_srdf -->

    <!-- left hand - left hand sc -->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_fr3_hand"        link2="left_fr3_hand_sc" reason="Adjacent"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="left_fr3_hand_sc" reason="Default"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_hand_sc" reason="Default"/>
        </xacro:if>
    </xacro:if>
    

    <!-- left hand - left d435i-->
    <xacro:if value="$(arg hand)">
        <disable_collisions link1="left_fr3_hand"        link2="left_d435i_link" reason="Default"/>
        <disable_collisions link1="left_fr3_leftfinger"  link2="left_d435i_link" reason="Default"/>
        <disable_collisions link1="left_fr3_rightfinger" link2="left_d435i_link" reason="Default"/>
    </xacro:if>

    <!-- left hand - left arm -->
    <!-- already in franka_arm_srdf -->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_fr3_hand"        link2="left_fr3_link0" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="left_fr3_link1" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="left_fr3_link2" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="left_fr3_link5" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="left_fr3_link0" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="left_fr3_link1" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="left_fr3_link2" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="left_fr3_link5" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_link0" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_link1" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_link2" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_link5" reason="User"/>
        </xacro:if>
    </xacro:if>

    <!-- left hand - left arm sc -->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_fr3_hand"        link2="left_fr3_link4_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_hand"        link2="left_fr3_link5_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_hand"        link2="left_fr3_link6_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_hand"        link2="left_fr3_link7_sc" reason="Default"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="left_fr3_link4_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="left_fr3_link5_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="left_fr3_link6_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="left_fr3_link7_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_link4_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_link5_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_link6_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_link7_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_hand"        link2="left_fr3_link0_sc" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="left_fr3_link1_sc" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="left_fr3_link2_sc" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="left_fr3_link3_sc" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="left_fr3_link0_sc" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="left_fr3_link1_sc" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="left_fr3_link2_sc" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="left_fr3_link3_sc" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_link0_sc" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_link1_sc" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_link2_sc" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_link3_sc" reason="User"/>
        </xacro:if>
    </xacro:if>

    <!-- left hand - right hand -->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_hand"        reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_leftfinger"  reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_rightfinger" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_hand"        reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_leftfinger"  reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_rightfinger" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_hand"        reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_leftfinger"  reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_rightfinger" reason="User"/>
        </xacro:if>
    </xacro:if>

    <!-- left hand - right hand sc -->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_hand_sc" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_hand_sc" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_hand_sc" reason="User"/>
        </xacro:if>
    </xacro:if>

    <!-- left hand - right arm -->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)"> 
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link0" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link1" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link2" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link3" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link4" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link5" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link6" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link7" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link0" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link1" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link2" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link3" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link4" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link5" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link6" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link7" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link0" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link1" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link2" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link3" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link4" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link5" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link6" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link7" reason="User"/>
        </xacro:if>
    </xacro:if>

    <!-- left hand - right arm sc -->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)"> 
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link0_sc" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link1_sc" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link2_sc" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link3_sc" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link4_sc" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link5_sc" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link6_sc" reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="right_fr3_link7_sc" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link0_sc" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link1_sc" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link2_sc" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link3_sc" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link4_sc" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link5_sc" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link6_sc" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_fr3_link7_sc" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link0_sc" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link1_sc" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link2_sc" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link3_sc" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link4_sc" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link5_sc" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link6_sc" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_fr3_link7_sc" reason="User"/>
        </xacro:if>
    </xacro:if>

    <!-- left hand - right d435i -->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_fr3_hand"        link2="right_d435i_link" reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="right_d435i_link" reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="right_d435i_link" reason="User"/>
        </xacro:if>
    </xacro:if>

    <!-- left hand - base-->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg mobile)">
            <disable_collisions link1="left_fr3_hand"        link2="base_link"                        reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="base_link"                        reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="base_link"                        reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="front_left_wheel"                reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="front_left_wheel"                reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="front_left_wheel"                reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="front_right_wheel"               reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="front_right_wheel"               reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="front_right_wheel"               reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="rear_left_wheel"                 reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="rear_left_wheel"                 reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="rear_left_wheel"                 reason="User"/>
            <disable_collisions link1="left_fr3_hand"        link2="rear_right_wheel"                reason="User"/>
            <disable_collisions link1="left_fr3_leftfinger"  link2="rear_right_wheel"                reason="User"/>
            <disable_collisions link1="left_fr3_rightfinger" link2="rear_right_wheel"                reason="User"/>
            
            <xacro:if value="$(arg with_sc)">
                <disable_collisions link1="left_fr3_hand"        link2="base_wheel_collision_box_link" reason="User"/>
                <disable_collisions link1="left_fr3_leftfinger"  link2="base_wheel_collision_box_link" reason="User"/>
                <disable_collisions link1="left_fr3_rightfinger" link2="base_wheel_collision_box_link" reason="User"/>
                <disable_collisions link1="left_fr3_hand"        link2="top_structure_link"            reason="User"/>
                <disable_collisions link1="left_fr3_leftfinger"  link2="top_structure_link"            reason="User"/>
                <disable_collisions link1="left_fr3_rightfinger" link2="top_structure_link"            reason="User"/>
            </xacro:if>
        </xacro:if>

        <xacro:unless value="$(arg mobile)">
            <xacro:if value="$(arg with_sc)">
                <disable_collisions link1="left_fr3_hand"        link2="left_base_link"  reason="User"/>
                <disable_collisions link1="left_fr3_leftfinger"  link2="left_base_link"  reason="User"/>
                <disable_collisions link1="left_fr3_rightfinger" link2="left_base_link"  reason="User"/>
                <disable_collisions link1="left_fr3_hand"        link2="right_base_link" reason="User"/>
                <disable_collisions link1="left_fr3_leftfinger"  link2="right_base_link" reason="User"/>
                <disable_collisions link1="left_fr3_rightfinger" link2="right_base_link" reason="User"/>
            </xacro:if>
        </xacro:unless>
    </xacro:if>

    <!-- ============= left hand sc ============= -->

    <!-- left hand sc - left hand sc -->
    <!-- none -->
    
    <!-- left hand sc - left d435i-->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_fr3_hand_sc" link2="left_d435i_link" reason="Never"/>
        </xacro:if>
    </xacro:if>
    
    <!-- left hand sc - left arm -->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_fr3_hand_sc" link2="left_fr3_link0" reason="User"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="left_fr3_link1" reason="User"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="left_fr3_link2" reason="User"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="left_fr3_link3" reason="Never"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="left_fr3_link4" reason="Never"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="left_fr3_link5" reason="Never"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="left_fr3_link6" reason="Never"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="left_fr3_link7" reason="Default"/>
        </xacro:if>
    </xacro:if>
    
    <!-- left hand sc - left arm sc -->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_fr3_hand_sc" link2="left_fr3_link3_sc" reason="User"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="left_fr3_link4_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="left_fr3_link5_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="left_fr3_link6_sc" reason="Never"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="left_fr3_link7_sc" reason="Default"/>
        </xacro:if>
    </xacro:if>
    
    <!-- left hand sc - right hand -->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_fr3_hand_sc" link2="right_fr3_hand"        reason="User"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="right_fr3_leftfinger"  reason="User"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="right_fr3_rightfinger" reason="User"/>
        </xacro:if>
    </xacro:if>
    
    <!-- left hand sc - right hand sc -->
    <!-- none -->
    
    <!-- left hand sc - right arm -->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_fr3_hand_sc" link2="right_fr3_link0" reason="User"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="right_fr3_link1" reason="User"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="right_fr3_link2" reason="User"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="right_fr3_link3" reason="User"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="right_fr3_link4" reason="User"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="right_fr3_link5" reason="User"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="right_fr3_link6" reason="User"/>
            <disable_collisions link1="left_fr3_hand_sc" link2="right_fr3_link7" reason="User"/>
        </xacro:if>
    </xacro:if>
    
    <!-- left hand sc - right arm sc -->
    <!-- none -->
    
    <!-- left hand sc - right d435i -->
    <!-- none -->
    
    <!-- left hand sc - base -->
    <xacro:if value="$(arg hand)">
        <xacro:if value="$(arg with_sc)">
            <xacro:if value="$(arg mobile)">
                <disable_collisions link1="left_fr3_hand_sc" link2="base_link"                        reason="User"/>
                <disable_collisions link1="left_fr3_hand_sc" link2="front_left_wheel"                reason="User"/>
                <disable_collisions link1="left_fr3_hand_sc" link2="front_right_wheel"               reason="User"/>
                <disable_collisions link1="left_fr3_hand_sc" link2="rear_left_wheel"                 reason="User"/>
                <disable_collisions link1="left_fr3_hand_sc" link2="rear_right_wheel"                reason="User"/>
            </xacro:if>
        </xacro:if>
    </xacro:if>

    <!-- ============= left d435i ============= -->
    <!-- left d435i - left d435i -->
    <!-- none -->
    
    <!-- left d435i - left arm -->
    <xacro:if value="$(arg use_d435i)">
        <disable_collisions link1="left_d435i_link" link2="left_fr3_link3" reason="Never"/>
        <disable_collisions link1="left_d435i_link" link2="left_fr3_link4" reason="Never"/>
        <disable_collisions link1="left_d435i_link" link2="left_fr3_link5" reason="Never"/>
        <disable_collisions link1="left_d435i_link" link2="left_fr3_link6" reason="Never"/>
        <disable_collisions link1="left_d435i_link" link2="left_fr3_link7" reason="Never"/>

        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_d435i_link" link2="left_fr3_link0" reason="User"/>
            <disable_collisions link1="left_d435i_link" link2="left_fr3_link1" reason="User"/>
            <disable_collisions link1="left_d435i_link" link2="left_fr3_link2" reason="User"/>
        </xacro:if>
    </xacro:if>

    <!-- left d435i - left arm sc -->
    <xacro:if value="$(arg use_d435i)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_d435i_link" link2="left_fr3_link3_sc" reason="User"/>
            <disable_collisions link1="left_d435i_link" link2="left_fr3_link4_sc" reason="Never"/>
            <disable_collisions link1="left_d435i_link" link2="left_fr3_link5_sc" reason="Never"/>
            <disable_collisions link1="left_d435i_link" link2="left_fr3_link6_sc" reason="Never"/>
            <disable_collisions link1="left_d435i_link" link2="left_fr3_link7_sc" reason="Never"/>
        </xacro:if>
    </xacro:if>

    <!-- left d435i - right hand -->
    <xacro:if value="$(arg use_d435i)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_d435i_link" link2="right_fr3_hand"        reason="User"/>
            <disable_collisions link1="left_d435i_link" link2="right_fr3_leftfinger"  reason="User"/>
            <disable_collisions link1="left_d435i_link" link2="right_fr3_rightfinger" reason="User"/>   
        </xacro:if>
    </xacro:if>

    <!-- left d435i - right hand sc -->
    <!-- none -->

    <!-- left d435i - right arm -->
    <xacro:if value="$(arg use_d435i)">
        <xacro:if value="$(arg with_sc)">
            <disable_collisions link1="left_d435i_link" link2="right_fr3_link0" reason="User"/>
            <disable_collisions link1="left_d435i_link" link2="right_fr3_link1" reason="User"/>
