<?xml version="1.0"?>

<robot name="realsense_d435i" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <material name="aluminum">
      <color rgba="0.5 0.5 0.5 1"/>
    </material>
    <material name="plastic">
      <color rgba="0.1 0.1 0.1 1"/>
    </material>

    <xacro:property name="M_PI" value="3.1415926535897931" />

    <!-- The following values are approximate, and the camera node
    publishing TF values with actual calibrated camera extrinsic values -->
    <xacro:property name="d435_cam_depth_to_infra1_offset" value="0.0"/>
    <xacro:property name="d435_cam_depth_to_infra2_offset" value="-0.050"/>
    <xacro:property name="d435_cam_depth_to_color_offset" value="0.015"/>

    <!-- The following values model the aluminum peripherial case for the
    D435 camera, with the camera joint represented by the actual
    peripherial camera tripod mount -->
    <xacro:property name="d435_cam_width" value="0.090"/>
    <xacro:property name="d435_cam_height" value="0.025"/>
    <xacro:property name="d435_cam_depth" value="0.02505"/>
    <xacro:property name="d435_cam_mount_from_center_offset" value="0.0149"/>
    <!-- glass cover is 0.1 mm inwards from front aluminium plate -->
    <xacro:property name="d435_glass_to_front" value="0.1e-3"/>
    <!-- see datasheet Revision 007, Fig. 4-4 page 65 -->
    <xacro:property name="d435_zero_depth_to_glass" value="4.2e-3"/>
    <!-- convenience precomputation to avoid clutter-->
    <xacro:property name="d435_mesh_x_offset" value="${d435_cam_mount_from_center_offset-d435_glass_to_front-d435_zero_depth_to_glass}"/>

    <!-- The following offset is relative the the physical D435 camera peripherial
    camera tripod mount -->
    <xacro:property name="d435_cam_depth_px" value="${d435_cam_mount_from_center_offset}"/>
    <xacro:property name="d435_cam_depth_py" value="0.0175"/>
        <xacro:property name="d435_cam_depth_pz" value="${d435_cam_height/2}"/>

    
    <xacro:macro name="realsense_d435i" params="is_reverse:=false prefix=''">
        <xacro:property name="cam_prefix" value="${'' if prefix=='' else prefix + '_'}"/> 
        <link name="${cam_prefix}d435i_bottom_screw_frame"/>
        <link name="${cam_prefix}d435i_link">
            <visual>
                <origin xyz="${d435_zero_depth_to_glass + d435_glass_to_front} ${-d435_cam_depth_py} 0" rpy="${M_PI/2} 0 ${M_PI/2}"/>
                <geometry>
                    <mesh filename="package://fr3_husky_description/meshes/d435.dae" />
                </geometry>  
            </visual>
            <collision>
                <origin xyz="-0.0085 ${-d435_cam_depth_py} 0" rpy="0 0 0"/>
                <geometry>
                <box size="${d435_cam_depth} ${d435_cam_width} ${d435_cam_height}"/>
                </geometry>
            </collision>
            <inertial>
                <!-- The following are not reliable values, and should not be used for modeling -->
                <mass value="0.072" />
                <origin xyz="0 0 0" />
                <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257" />
            </inertial>
        </link>
        <link name="${cam_prefix}d435i_depth_frame"/>
        <link name="${cam_prefix}d435i_depth_optical_frame"/>
        <link name="${cam_prefix}d435i_infra1_frame"/>
        <link name="${cam_prefix}d435i_infra1_optical_frame"/>
        <link name="${cam_prefix}d435i_infra2_frame"/>
        <link name="${cam_prefix}d435i_infra2_optical_frame"/>
        <link name="${cam_prefix}d435i_color_frame"/>
        <link name="${cam_prefix}d435i_color_optical_frame"/>

        <xacro:unless value="${is_reverse}">
            <joint name="${cam_prefix}d435i_link_joint" type="fixed">
                <origin xyz="${d435_mesh_x_offset} ${d435_cam_depth_py} ${d435_cam_depth_pz}" rpy="0 0 0"/>
                <parent link="${cam_prefix}d435i_bottom_screw_frame"/>
                <child link="${cam_prefix}d435i_link" />
            </joint>
            <joint name="${cam_prefix}d435i_depth_joint" type="fixed">
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <parent link="${cam_prefix}d435i_link"/>
                <child link="${cam_prefix}d435i_depth_frame" />
            </joint>

            <joint name="${cam_prefix}d435i_depth_optical_joint" type="fixed">
                <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
                <parent link="${cam_prefix}d435i_depth_frame" />
                <child link="${cam_prefix}d435i_depth_optical_frame" />
            </joint>

            <!-- camera left IR joints and links -->
            <joint name="${cam_prefix}d435i_infra1_joint" type="fixed">
                <origin xyz="0 ${d435_cam_depth_to_infra1_offset} 0" rpy="0 0 0" />
                <parent link="${cam_prefix}d435i_link" />
                <child link="${cam_prefix}d435i_infra1_frame" />
            </joint>

            <joint name="${cam_prefix}d435i_infra1_optical_joint" type="fixed">
                <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
                <parent link="${cam_prefix}d435i_infra1_frame" />
                <child link="${cam_prefix}d435i_infra1_optical_frame" />
            </joint>

            <!-- camera right IR joints and links -->
            <joint name="${cam_prefix}d435i_infra2_joint" type="fixed">
                <origin xyz="0 ${d435_cam_depth_to_infra2_offset} 0" rpy="0 0 0" />
                <parent link="${cam_prefix}d435i_link" />
                <child link="${cam_prefix}d435i_infra2_frame" />
            </joint>

            <joint name="${cam_prefix}d435i_infra2_optical_joint" type="fixed">
                <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
                <parent link="${cam_prefix}d435i_infra2_frame" />
                <child link="${cam_prefix}d435i_infra2_optical_frame" />
            </joint>

            <!-- camera color joints and links -->
            <joint name="${cam_prefix}d435i_color_joint" type="fixed">
                <origin xyz="0 ${d435_cam_depth_to_color_offset} 0" rpy="0 0 0" />
                <parent link="${cam_prefix}d435i_link" />
                <child link="${cam_prefix}d435i_color_frame" />
            </joint>

            <joint name="${cam_prefix}d435i_color_optical_joint" type="fixed">
                <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
                <parent link="${cam_prefix}d435i_color_frame" />
                <child link="${cam_prefix}d435i_color_optical_frame" />
            </joint>
            
        </xacro:unless>

        <xacro:if value="${is_reverse}">
             <joint name="${cam_prefix}d435i_color_optical_joint" type="fixed">
                <origin xyz="0 0 0" rpy="0 ${-M_PI/2} ${M_PI/2}" />
                <parent link="${cam_prefix}d435i_color_optical_frame" />
                <child link="${cam_prefix}d435i_color_frame" />
            </joint>

            <!-- camera color joints and links -->
            <joint name="${cam_prefix}d435i_color_joint" type="fixed">
                <origin xyz="0 -${d435_cam_depth_to_color_offset} 0" rpy="0 0 0" />
                <parent link="${cam_prefix}d435i_color_frame" />
                <child link="${cam_prefix}d435i_link" />
            </joint>

             <joint name="${cam_prefix}d435i_link_joint" type="fixed">
                <origin xyz="-${d435_mesh_x_offset} -${d435_cam_depth_py} -${d435_cam_depth_pz}" rpy="0 0 0"/>
                <parent link="${cam_prefix}d435i_link" />
                <child link="${cam_prefix}d435i_bottom_screw_frame"/>
            </joint>

            <joint name="${cam_prefix}d435i_depth_joint" type="fixed">
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <parent link="${cam_prefix}d435i_link"/>
                <child link="${cam_prefix}d435i_depth_frame" />
            </joint>

            <joint name="${cam_prefix}d435i_depth_optical_joint" type="fixed">
                <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
                <parent link="${cam_prefix}d435i_depth_frame" />
                <child link="${cam_prefix}d435i_depth_optical_frame" />
            </joint>

            <!-- camera left IR joints and links -->
            <joint name="${cam_prefix}d435i_infra1_joint" type="fixed">
                <origin xyz="0 ${d435_cam_depth_to_infra1_offset} 0" rpy="0 0 0" />
                <parent link="${cam_prefix}d435i_link" />
                <child link="${cam_prefix}d435i_infra1_frame" />
            </joint>

            <joint name="${cam_prefix}d435i_infra1_optical_joint" type="fixed">
                <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
                <parent link="${cam_prefix}d435i_infra1_frame" />
                <child link="${cam_prefix}d435i_infra1_optical_frame" />
            </joint>

            <!-- camera right IR joints and links -->
            <joint name="${cam_prefix}d435i_infra2_joint" type="fixed">
                <origin xyz="0 ${d435_cam_depth_to_infra2_offset} 0" rpy="0 0 0" />
                <parent link="${cam_prefix}d435i_link" />
                <child link="${cam_prefix}d435i_infra2_frame" />
            </joint>

            <joint name="${cam_prefix}d435i_infra2_optical_joint" type="fixed">
                <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
                <parent link="${cam_prefix}d435i_infra2_frame" />
                <child link="${cam_prefix}d435i_infra2_optical_frame" />
            </joint>
        </xacro:if>
    </xacro:macro>
</robot>